###############################################################################
# Retail AI Frontend Environment Configuration
# Copy to frontend/.env and fill in real values.
#
# IMPORTANT: This is a Create React App project (react-scripts). Only
# variables prefixed with REACT_APP_ get baked into the build, and they are
# baked in AT BUILD TIME (npm run build) — not read at runtime. If you change
# these values, you must rebuild the frontend for them to take effect.
#
# Removed: VITE_* and REACT_AUTH0_* variables from the old template — this is
# not a Vite project, and those prefixes are never read by react-scripts.
###############################################################################

REACT_APP_API_BASE_URL=http://YOUR_SERVER_IP_OR_DOMAIN/api

