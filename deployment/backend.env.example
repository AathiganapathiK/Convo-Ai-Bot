###############################################################################
# Retail AI Backend Environment Configuration
# Copy to backend/.env and fill in real values. NEVER commit the real .env.
###############################################################################

APP_NAME=Retail AI Analytics Platform
APP_ENV=production
APP_DEBUG=false
HOST=0.0.0.0
PORT=8000

FRONTEND_ORIGIN=http://YOUR_SERVER_IP_OR_DOMAIN

###############################################################################
# Database (Platform DB) — SQL SERVER AUTHENTICATION
# IMPORTANT: On Linux, Windows trusted_connection is NOT usable. This app
# must connect using a SQL Server login (username/password), which requires
# the small code fix described in the accompanying README (database.py).
###############################################################################

DB_TYPE=mssql
DB_HOST=localhost
DB_PORT=1433
DB_NAME=RR_platform
DB_USER=retail_ai_app
DB_PASSWORD=changeme
DB_DRIVER=ODBC Driver 18 for SQL Server

###############################################################################
# Auth0
###############################################################################

AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://your-api-identifier
JWT_ALGORITHM=RS256

###############################################################################
# LLM Provider
###############################################################################

GROQ_API_KEY=changeme
DEFAULT_PROVIDER=groq
DEFAULT_MODEL=llama-3.3-70b-versatile

###############################################################################
# Security
###############################################################################

ENCRYPTION_KEY=changeme
ALLOWED_TABLES=

###############################################################################
# Misc / Optional
###############################################################################

LOG_LEVEL=INFO
SALES_CSV_PATH=

ENABLE_QDRANT=false
QDRANT_HOST=localhost
QDRANT_PORT=6333
