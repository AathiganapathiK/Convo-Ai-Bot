###############################################################################
# Retail AI Analytics Platform — Docker Environment Configuration
# Copy this file to '.env' in the root directory and update the values.
# NEVER commit the actual '.env' file to version control.
###############################################################################

# ==========================================
# Application Configuration
# ==========================================
APP_NAME="Retail AI Analytics Platform"
APP_ENV=local
APP_DEBUG=true

# CORS Origin config - Frontend URL (no trailing slash)
# Since they run on the same server, this will be your domain or public IP.
FRONTEND_ORIGIN=http://localhost:3000

# ==========================================
# Database Connection (External SQL Server)
# ==========================================
# DB_TYPE should remain mssql (or sqlserver)
DB_TYPE=mssql

# To connect to SQL Server running on the Docker host, use host.docker.internal
# inside Docker. Ensure docker-compose.yml maps this to host-gateway.
DB_HOST=192.168.0.187
DB_PORT=1433
DB_NAME=RR_platform

# SQL Server Authentication credentials
DB_USER=
DB_PASSWORD=

# Use ODBC Driver 18 (installed in the backend container)
DB_DRIVER="ODBC Driver 18 for SQL Server"

# Timeout in seconds for waiting for the database to become reachable
DB_WAIT_TIMEOUT=60

# ==========================================
# Cryptography and Authentication
# ==========================================
# Generate a secure random key: openssl rand -hex 32
JWT_SECRET=3a3f4808aca8f54a51c9741be18cf9dfe0e7d84ed3d584bf010840f597eaa8f5

# JWT Details
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Encrypts sensitive database connection info stored inside RR_platform
# Generate using cryptography.fernet.Fernet.generate_key() or keygen
ENCRYPTION_KEY=4F_xPlLT1URhMVxuMPMoZ8Hgmwq5flt0j8zqSj6-2GY=

# ==========================================
# AI Services Configuration
# ==========================================
# Groq API Credentials
GROQ_API_KEY=yOUR_GROQ_API

DEFAULT_PROVIDER=groq
DEFAULT_MODEL=llama-3.3-70b-versatile

# ==========================================
# Logging & Debugging
# ==========================================
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=DEBUG

# ==========================================
# Optional/Future Integrations
# ==========================================
ENABLE_QDRANT=false
QDRANT_HOST=localhost
QDRANT_PORT=6333
